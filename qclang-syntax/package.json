{
    "name": "qclang",
    "displayName": "QcLang",
    "description": "Support complet pour QcLang - Le langage de programmation québécois 🍁",
    "version": "1.1.0",
    "publisher": "fragmatyc",
    "repository": {
        "type": "git",
        "url": "https://github.com/fragmatyc/qc-lang"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Linters"
    ],
    "activationEvents": [
        "onLanguage:qclang"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "qclang",
                "aliases": [
                    "QcLang",
                    "qclang"
                ],
                "extensions": [
                    ".qc"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "qclang",
                "scopeName": "source.qclang",
                "path": "./syntaxes/qclang.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "qclang",
                "path": "./snippets/qclang.json"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/node": "^18.0.0",
        "@types/vscode": "^1.75.0",
        "typescript": "^5.0.0"
    }
}